<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lis.mapper.SysXtszMapper">

    <select id="selectBarcodePrefix" resultType="string">
        SELECT cssz1 FROM sys_xtsz WHERE xtsz_key = 'barcode_prefix'
    </select>

    <select id="selectHospitalName" resultType="string">
        SELECT cssz1 FROM sys_xtsz WHERE xtsz_key = 'bgbt'
    </select>

</mapper>
